{
  "name": "loom-monorepo",
  "version": "0.4.1",
  "private": true,
  "description": "LOOM v0.4.1 — Semantic persistent context OS for AI agents",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces",
    "build:core": "npm run build -w packages/loom-core",
    "build:cli": "npm run build -w packages/loom-cli",
    "build:mcp": "npm run build -w packages/loom-mcp",
    "build:cloud": "npm run build -w packages/loom-cloud",
    "build:aggregator": "npm run build -w packages/loom-aggregator",
    "test": "npm run test --workspaces",
    "test:core": "npm run test -w packages/loom-core",
    "test:cli": "npm run test -w packages/loom-cli",
    "test:mcp": "npm run test -w packages/loom-mcp",
    "test:cloud": "npm run test -w packages/loom-cloud",
    "lint": "eslint packages/*/src/**/*.ts",
    "clean": "rm -rf packages/*/dist packages/*/node_modules/.cache"
  },
  "devDependencies": {
    "@eslint/js": "^9.24.0",
    "eslint": "^9.24.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.58.2"
  },
  "engines": {
    "node": ">=18"
  }
}
